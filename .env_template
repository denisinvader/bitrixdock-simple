# Each directory is an independent Docker Compose project.
# To run several projects from one directory, set COMPOSE_PROJECT_NAME when running Docker.

# Site is available at http://${HTTP_BIND_ADDRESS}:${HTTP_PORT}
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Site files on the host
SITE_PATH=./www

# PHP image directory: php80, php81, php82, php83, php84, php85
PHP_VERSION=php82

# Database
MYSQL_VERSION=8.4
MYSQL_DATABASE=bitrix
MYSQL_USER=bitrix
MYSQL_PASSWORD=bitrix
MYSQL_ROOT_PASSWORD=root

TZ=Europe/Moscow
